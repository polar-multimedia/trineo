{
  "rules": {
    "trineo": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@polarmultimedia.com')",
      "tracking": {
        "$doc": {
          "visits": { "$code": { "$id": {
            ".write": "!data.exists() || data.child('device').val() === newData.child('device').val()",
            ".validate": "newData.hasChildren(['start','device'])"
          } } },
          "downloads": { "$code": { "$id": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['ts','device'])"
          } } }
        }
      },
      "directorio": {
        "$doc": { "$code": { "name": { ".read": true }, "cargo": { ".read": true } } },
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@polarmultimedia.com')"
      },
      "seguimiento": {
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.endsWith('@polarmultimedia.com')"
      }
    }
  }
}
